<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.collections.*?>


<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1200.0" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.serverside.ServerController"
            style="-fx-background-image:url('file:src/main/resources/images/DefaultMenuBG.png'); 
                   -fx-background-size: cover; 
                   -fx-background-position: center;">
    
    <VBox layoutX="200" layoutY="400" spacing="30" alignment="CENTER">
        <!-- Toggle Button -->
        <Button fx:id="toggleButton" text="Start" 
                prefHeight="100.0" prefWidth="350.0"
                onAction="#toggleAction"
                styleClass="start-button"/>
    </VBox>
    
    <StackPane layoutX="800" layoutY="200">
        <!-- Spinner Wheel using PieChart -->
        <PieChart fx:id="pieChart" 
                  prefWidth="500" prefHeight="500"
                  legendVisible="false"
                  labelsVisible="true"
                  startAngle="90"
                  style="-fx-background-color: transparent;"/>
        
        <!-- Center white circle -->
        <Circle radius="5" fill="white" 
                style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 0);"/>
    </StackPane>
</AnchorPane>