<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.collections.*?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="1200.0" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.mycompany.serverside.ServerController"
            style="-fx-background-image:url('file:src/main/resources/images/DefaultMenuBG.png'); 
                   -fx-background-size: cover; 
                   -fx-background-position: center;">
    
    <VBox layoutX="200" layoutY="400" spacing="30" alignment="CENTER">
        
        <Button fx:id="toggleButton" text="Start" 
                prefHeight="100.0" prefWidth="350.0"
                onAction="#toggleAction"
                styleClass="start-button"/>
    </VBox>
    
    <AnchorPane fx:id="chartContainer" 
                layoutX="900" 
                layoutY="180"
                prefHeight="500.0" 
                prefWidth="400.0"
                style="-fx-background-color: rgba(255, 255, 255, 0.9); 
                       -fx-background-radius: 15; 
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);"/>
    
</AnchorPane>